<div class="flex min-h-screen flex-col bg-base-100 text-base-content">
  <.flash kind={:info} flash={@flash} />
  <.flash kind={:error} flash={@flash} />

  <header class="flex flex-wrap items-center justify-between gap-4 border-b border-base-300 px-6 py-4">
    <div>
      <h1 class="font-display text-xl font-semibold tracking-tight">Chaos Playground</h1>
      <div class="flex items-center gap-1.5">
        <p class="text-sm text-base-content/60">
          {@topology.name} — Chaos Engineering en vivo: cada nodo es un proceso OTP real
        </p>
        <button
          id="help-open"
          type="button"
          aria-label="Cómo usar esto"
          title="Cómo usar esto"
          class="text-base-content/40 hover:text-primary"
        >
          <.icon name="hero-question-mark-circle" class="size-4" />
        </button>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <div
        class="hidden items-center gap-2 rounded-lg border border-base-300 bg-base-200/40 px-3 py-2 sm:flex"
        title="RPS (naranja) y % de error (rojo) — ultimos 20s"
      >
        <svg viewBox="0 0 160 48" class="h-12 w-40" preserveAspectRatio="none">
          <polygon
            points={chart_area_points(@metrics_history, :rps, 160, 48)}
            class="fill-primary/10"
          />
          <polyline
            points={chart_points(@metrics_history, :rps, 160, 48)}
            fill="none"
            class="stroke-primary"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
          />
          <polyline
            points={chart_points(@metrics_history, :error_rate, 160, 48, 1.0)}
            fill="none"
            class="stroke-status-dead"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-dasharray="3 2"
            vector-effect="non-scaling-stroke"
          />
        </svg>
        <span class="font-data text-[10px] uppercase tracking-wide text-base-content/40">20s</span>
      </div>

      <dl id="metrics-dl" class="flex gap-6 font-data text-sm">
        <div>
          <dt class="text-xs uppercase tracking-wide text-base-content/50">RPS</dt>
          <dd class="text-lg tabular-nums">{@metrics.rps}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-base-content/50">p99</dt>
          <dd class="text-lg tabular-nums">{@metrics.p99_ms}ms</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-wide text-base-content/50">Errores</dt>
          <dd class={["text-lg tabular-nums transition-colors", @metrics.error_rate > 0.1 && "text-status-dead"]}>
            {round(@metrics.error_rate * 100)}%
          </dd>
        </div>
      </dl>

      <div class="flex items-center gap-2 font-data text-xs text-base-content/60">
        <%= if @current_scope do %>
          <span class="hidden sm:inline">{@current_scope.user.email}</span>
          <.link navigate={~p"/users/settings"} class="hover:text-primary">Configuración</.link>
          <span class="text-base-content/30">·</span>
          <.link href={~p"/users/log-out"} method="delete" class="hover:text-primary">
            Cerrar sesión
          </.link>
        <% else %>
          <.link navigate={~p"/users/log-in"} class="hover:text-primary">Iniciar sesión</.link>
          <span class="text-base-content/30">·</span>
          <.link navigate={~p"/users/register"} class="hover:text-primary">Registrarme</.link>
        <% end %>
      </div>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar tema claro/oscuro"
        class="theme-toggle"
      >
        <.icon name="hero-sun" class="theme-toggle-sun size-5" />
        <.icon name="hero-moon" class="theme-toggle-moon size-5" />
      </button>
    </div>
  </header>

  <div class="flex min-h-0 flex-1 flex-col gap-4 p-4 lg:flex-row">
    <div class="flex-1 overflow-hidden rounded-lg border border-base-300 bg-base-200/40 canvas-grid">
      <div id="network-canvas" phx-hook=".NetworkCanvas" class="aspect-[2/1] w-full lg:aspect-auto lg:h-full">
        <svg viewBox="-30 -30 1010 460" class="h-full w-full">
          <g>
            <%= for {from_id, node} <- @nodes, to_id <- node.connections do %>
              <% from_spec = node_position(@topology, from_id) %>
              <% to_spec = node_position(@topology, to_id) %>
              <%= if from_spec && to_spec do %>
                <line
                  x1={from_spec.x}
                  y1={from_spec.y}
                  x2={to_spec.x}
                  y2={to_spec.y}
                  stroke-width="2"
                  class="cursor-pointer stroke-base-content/25 hover:stroke-primary"
                  phx-click="select_edge"
                  phx-value-from={from_id}
                  phx-value-to={to_id}
                />
              <% end %>
            <% end %>
          </g>

          <line
            id="drag-preview"
            phx-update="ignore"
            class="pointer-events-none hidden stroke-primary"
            stroke-width="2"
            stroke-dasharray="4 3"
            x1="0"
            y1="0"
            x2="0"
            y2="0"
          />

          <g>
            <%= for spec <- @topology.nodes do %>
              <% node = Map.fetch!(@nodes, spec.id) %>
              <g
                data-node-id={spec.id}
                transform={"translate(#{spec.x}, #{spec.y})"}
                class="cursor-pointer"
                phx-click="select_node"
                phx-value-id={spec.id}
              >
                <circle
                  r="26"
                  stroke-width="2"
                  stroke="currentColor"
                  stroke-dasharray={node.status == :dead && "6 4"}
                  data-status={node.status}
                  class={["node-circle", node_fill_class(node.status)]}
                />
                <text
                  text-anchor="middle"
                  dy="-2"
                  class="pointer-events-none select-none fill-base-100 font-data text-[10px] font-bold"
                >
                  {type_label(spec.type)}
                </text>
                <text
                  text-anchor="middle"
                  dy="42"
                  class="pointer-events-none select-none fill-base-content/70 font-data text-[10px]"
                >
                  {spec.id}
                </text>
              </g>
            <% end %>
          </g>

          <g id="particles" phx-update="ignore"></g>
        </svg>

        <script :type={Phoenix.LiveView.ColocatedHook} name=".NetworkCanvas">
          export default {
            mounted() {
              this.particles = this.el.querySelector("#particles");
              this.dragPreview = this.el.querySelector("#drag-preview");
              this.svg = this.el.querySelector("svg");
              this.dragging = null;

              this.handleEvent("packet_hop", ({ from, to, duration_ms }) => {
                this.animateHop(from, to, duration_ms);
              });

              this.onPointerDown = (e) => {
                const nodeEl = e.target.closest("[data-node-id]");
                if (!nodeEl) return;
                this.dragging = nodeEl.dataset.nodeId;
                const [x, y] = this.nodeCenter(this.dragging);
                this.setPreview(x, y, x, y);
                this.dragPreview.classList.remove("hidden");
              };

              this.onPointerMove = (e) => {
                if (!this.dragging) return;
                const [x1, y1] = this.nodeCenter(this.dragging);
                const p = this.toSvgPoint(e.clientX, e.clientY);
                this.setPreview(x1, y1, p.x, p.y);
              };

              this.onPointerUp = (e) => {
                if (!this.dragging) return;
                const targetEl = e.target.closest && e.target.closest("[data-node-id]");
                this.dragPreview.classList.add("hidden");
                if (targetEl && targetEl.dataset.nodeId !== this.dragging) {
                  this.pushEvent("connect_nodes", { from: this.dragging, to: targetEl.dataset.nodeId });
                }
                this.dragging = null;
              };

              this.el.addEventListener("pointerdown", this.onPointerDown);
              this.el.addEventListener("pointermove", this.onPointerMove);
              window.addEventListener("pointerup", this.onPointerUp);
            },

            destroyed() {
              window.removeEventListener("pointerup", this.onPointerUp);
            },

            nodeCenter(id) {
              const g = this.el.querySelector(`[data-node-id="${id}"]`);
              if (!g) return [0, 0];
              const m = g.getAttribute("transform").match(/translate\(([-\d.]+),\s*([-\d.]+)\)/);
              return [parseFloat(m[1]), parseFloat(m[2])];
            },

            toSvgPoint(clientX, clientY) {
              const pt = this.svg.createSVGPoint();
              pt.x = clientX;
              pt.y = clientY;
              return pt.matrixTransform(this.svg.getScreenCTM().inverse());
            },

            setPreview(x1, y1, x2, y2) {
              this.dragPreview.setAttribute("x1", x1);
              this.dragPreview.setAttribute("y1", y1);
              this.dragPreview.setAttribute("x2", x2);
              this.dragPreview.setAttribute("y2", y2);
            },

            animateHop(fromId, toId, durationMs) {
              // Recorre solo el tramo entre los bordes de los nodos (radio 26, igual al <circle>
              // del canvas) y funde in/out en las puntas, asi la particula "entra" y "sale"
              // del nodo en vez de superponerse encima de su circulo.
              const NODE_R = 26;
              const [cx1, cy1] = this.nodeCenter(fromId);
              const [cx2, cy2] = this.nodeCenter(toId);
              const dist = Math.hypot(cx2 - cx1, cy2 - cy1) || 1;
              const ux = (cx2 - cx1) / dist;
              const uy = (cy2 - cy1) / dist;
              const x1 = cx1 + ux * NODE_R;
              const y1 = cy1 + uy * NODE_R;
              const x2 = cx2 - ux * NODE_R;
              const y2 = cy2 - uy * NODE_R;

              const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
              dot.setAttribute("r", "4");
              dot.setAttribute("cx", x1);
              dot.setAttribute("cy", y1);
              dot.setAttribute("class", "fill-primary");
              this.particles.appendChild(dot);

              const anim = dot.animate(
                [
                  { transform: "translate(0px,0px)", opacity: 0 },
                  { transform: "translate(0px,0px)", opacity: 1, offset: 0.12 },
                  { transform: `translate(${x2 - x1}px, ${y2 - y1}px)`, opacity: 1, offset: 0.88 },
                  { transform: `translate(${x2 - x1}px, ${y2 - y1}px)`, opacity: 0 },
                ],
                { duration: durationMs, easing: "linear", fill: "forwards" }
              );
              anim.onfinish = () => dot.remove();
            }
          };
        </script>
      </div>
    </div>

    <aside class="flex w-full flex-col gap-4 overflow-y-auto lg:h-full lg:w-80">
      <section class="rounded-lg border border-base-300 bg-base-200/40 p-4">
        <h2 class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-base-content/60">
          Tráfico
        </h2>

        <div class="flex gap-2">
          <button
            phx-click="start_traffic"
            disabled={@running?}
            class="btn btn-sm btn-primary flex-1"
          >
            <.icon name="hero-play" class="size-4" /> Iniciar
          </button>
          <button phx-click="pause_traffic" disabled={!@running?} class="btn btn-sm flex-1">
            <.icon name="hero-pause" class="size-4" /> Pausar
          </button>
        </div>

        <button id="guided-demo-btn" type="button" class="btn btn-sm btn-outline btn-primary mt-2 w-full">
          <.icon name="hero-play-circle" class="size-4" />
          <span id="guided-demo-label">Demo guiada (45s)</span>
        </button>

        <label for="rps-input" class="mt-3 block text-xs text-base-content/60">
          RPS objetivo: <span class="font-data">{@rps}</span>
        </label>
        <form id="rps-form" phx-change="set_rps">
          <input
            id="rps-input"
            type="range"
            name="rps"
            min="0"
            max="200"
            value={@rps}
            class="range range-primary range-sm"
          />
        </form>

        <%= if length(@entry_candidates) > 1 do %>
          <label for="entry-node-select" class="mt-3 block text-xs text-base-content/60">
            Entrada de tráfico
          </label>
          <form id="entry-node-form" phx-change="set_entry_node">
            <select id="entry-node-select" name="entry_node" class="select select-sm w-full">
              <%= for id <- @entry_candidates do %>
                <option value={id} selected={id == @entry_node}>{id}</option>
              <% end %>
            </select>
          </form>
        <% end %>
      </section>

      <section class="rounded-lg border border-base-300 bg-base-200/40 p-4">
        <h2 class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-base-content/60">
          Presets
        </h2>

        <div class="flex flex-col gap-2">
          <%= for preset <- @builtin_presets do %>
            <button
              phx-click="load_preset"
              phx-value-name={preset.name}
              class="btn btn-outline btn-sm justify-start"
            >
              <.icon name="hero-squares-2x2" class="size-4" /> {preset.name}
            </button>
          <% end %>
        </div>

        <%= if @saved_presets != [] do %>
          <div class="mt-3 flex flex-col gap-2 border-t border-base-300 pt-3">
            <%= for saved <- @saved_presets do %>
              <button
                phx-click="load_saved"
                phx-value-id={saved.id}
                class="btn btn-ghost btn-sm justify-start"
              >
                <.icon name="hero-bookmark" class="size-4" /> {saved.name}
              </button>
            <% end %>
          </div>
        <% end %>

        <div class="mt-3 border-t border-base-300 pt-3">
          <p class="mb-2 text-xs text-base-content/50">
            <%= if @current_scope do %>
              Guardá la topología actual como preset nuevo
            <% else %>
              <.link navigate={~p"/users/log-in"} class="text-primary hover:underline">
                Iniciá sesión
              </.link> para guardar la topología actual como preset
            <% end %>
          </p>
          <form phx-submit="save_topology" class="flex gap-2">
            <input
              type="text"
              name="name"
              placeholder="Nombre del preset"
              required
              class="input input-sm flex-1"
            />
            <button type="submit" class="btn btn-primary btn-sm">
              <.icon name="hero-bookmark" class="size-4" />
            </button>
          </form>
        </div>
      </section>

      <section id="inspector-panel" class="rounded-lg border border-base-300 bg-base-200/40 p-4">
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-base-content/60">
            Inspector
          </h2>
          <%= if @selected do %>
            <button
              phx-click="clear_selection"
              class="text-base-content/50 hover:text-base-content"
            >
              <.icon name="hero-x-mark" class="size-4" />
            </button>
          <% end %>
        </div>

        <%= case @selected do %>
          <% {:node, id} -> %>
            <% node = Map.fetch!(@nodes, id) %>
            <div class="flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="font-data text-sm">{id}</span>
                <span class={[
                  "rounded px-2 py-0.5 font-data text-xs",
                  status_badge_class(node.status)
                ]}>
                  {node.status}
                </span>
              </div>

              <div>
                <label for={"latency-input-#{id}"} class="text-xs text-base-content/60">
                  Latencia inyectada: <span class="font-data">{node.latency_ms}ms</span>
                </label>
                <form id={"latency-form-#{id}"} phx-change="set_latency">
                  <input type="hidden" name="node_id" value={id} />
                  <input
                    id={"latency-input-#{id}"}
                    type="range"
                    name="value"
                    min="0"
                    max="2000"
                    step="50"
                    value={node.latency_ms}
                    class="range range-sm"
                  />
                </form>
              </div>

              <div>
                <label for={"failure-rate-input-#{id}"} class="text-xs text-base-content/60">
                  Packet loss: <span class="font-data">{round(node.failure_rate * 100)}%</span>
                </label>
                <form id={"failure-rate-form-#{id}"} phx-change="set_failure_rate">
                  <input type="hidden" name="node_id" value={id} />
                  <input
                    id={"failure-rate-input-#{id}"}
                    type="range"
                    name="value"
                    min="0"
                    max="1"
                    step="0.05"
                    value={node.failure_rate}
                    class="range range-sm"
                  />
                </form>
              </div>

              <%= if node.status == :dead do %>
                <button phx-click="revive_node" phx-value-id={id} class="btn btn-outline btn-sm">
                  <.icon name="hero-arrow-path" class="size-4" /> Reiniciar nodo
                </button>
              <% else %>
                <button phx-click="kill_node" phx-value-id={id} class="btn btn-error btn-sm">
                  <.icon name="hero-bolt" class="size-4" /> Matar proceso
                </button>
              <% end %>
            </div>
          <% {:edge, from, to} -> %>
            <div class="flex flex-col gap-3">
              <p class="font-data text-sm">{from} &rarr; {to}</p>
              <button
                phx-click="disconnect_edge"
                phx-value-from={from}
                phx-value-to={to}
                class="btn btn-error btn-sm"
              >
                <.icon name="hero-x-mark" class="size-4" /> Eliminar conexión
              </button>
            </div>
          <% nil -> %>
            <p class="text-sm text-base-content/50">
              Clic en un nodo o una conexión del canvas. Arrastrá desde un nodo hasta otro para crear una conexión nueva.
            </p>
        <% end %>
      </section>
    </aside>
  </div>
</div>

<div id="onboarding-root" phx-update="ignore">
  <!-- Modal de bienvenida (primera visita) -->
  <div
    id="onboarding-modal"
    class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/60 p-4"
  >
    <div class="max-h-[85vh] max-w-md overflow-y-auto rounded-xl border border-base-300 bg-base-100 p-6 shadow-2xl">
      <h2 class="font-display text-lg font-semibold">Chaos Playground</h2>
      <p class="mt-2 text-sm text-base-content/70">
        Un playground de Chaos Engineering: armá una topología de infraestructura (load balancer,
        API, DB, cache, cola) y sometela a tráfico simulado en tiempo real para ver cómo se
        comporta bajo falla.
      </p>
      <p class="mt-2 text-sm text-base-content/70">
        Cada nodo de este canvas es un proceso real de Erlang/OTP (un <code class="font-data text-xs">GenServer</code>).
        Cuando lo "matás" desde acá, el proceso muere de verdad — no es una animación en JS.
      </p>
      <p class="mt-2 text-sm text-base-content/70">
        Podés ver una demo automática de 45 segundos, o directamente explorar por tu cuenta.
      </p>
      <div class="mt-5 flex flex-col gap-2 sm:flex-row">
        <button id="onboarding-start-demo" type="button" class="btn btn-primary btn-sm flex-1">
          <.icon name="hero-play-circle" class="size-4" /> Ver demo guiada
        </button>
        <button id="onboarding-skip" type="button" class="btn btn-ghost btn-sm flex-1">
          Explorar por mi cuenta
        </button>
      </div>
    </div>
  </div>

  <!-- Callout flotante usado por la demo guiada -->
  <div
    id="demo-callout"
    class="hidden fixed z-[60] w-[calc(100vw-24px)] max-w-72 rounded-lg border border-primary/40 bg-base-200 px-3 py-2.5 text-sm text-base-content shadow-xl"
  >
    <div class="mb-1.5 flex items-center justify-between">
      <span id="demo-callout-step" class="font-data text-[10px] uppercase tracking-wide text-base-content/40"></span>
      <button id="demo-skip" type="button" class="text-[10px] uppercase tracking-wide text-base-content/40 hover:text-base-content">
        Saltar demo ✕
      </button>
    </div>
    <p id="demo-callout-text"></p>
  </div>

  <!-- Modal de ayuda / manual rapido -->
  <div
    id="help-modal"
    class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/60 p-4"
  >
    <div class="max-h-[85vh] max-w-lg overflow-y-auto rounded-xl border border-base-300 bg-base-100 p-6 shadow-2xl">
      <div class="flex items-center justify-between">
        <h2 class="font-display text-lg font-semibold">Cómo usar esto</h2>
        <button id="help-close" type="button" class="text-base-content/50 hover:text-base-content">
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <ul class="mt-4 space-y-3 text-sm text-base-content/80">
        <li>
          <strong class="text-base-content">Presets:</strong>
          cargan una topología completa (nodos + conexiones) y reinician los procesos desde cero.
        </li>
        <li>
          <strong class="text-base-content">Iniciar / Pausar:</strong>
          arranca o frena la generación de tráfico simulado desde el nodo de entrada elegido.
        </li>
        <li>
          <strong class="text-base-content">RPS objetivo:</strong>
          cuántos paquetes por segundo intenta generar el motor de tráfico.
        </li>
        <li>
          <strong class="text-base-content">Clic en un nodo:</strong>
          abre el Inspector — desde ahí lo matás de verdad ("Matar proceso"), le inyectás latencia o packet loss artificial, o lo reiniciás.
        </li>
        <li>
          <strong class="text-base-content">Arrastrar entre nodos:</strong>
          crea una conexión nueva. Clic en una conexión existente para eliminarla.
        </li>
        <li>
          <strong class="text-base-content">Gráfico del header:</strong>
          RPS (naranja) y % de error (rojo punteado) de los últimos 20 segundos, actualizado en vivo.
        </li>
      </ul>

      <p class="mt-4 text-xs text-base-content/50">
        Todo lo que ves acá corre sobre supervisión OTP real: matar un nodo termina su proceso, no lo "apaga visualmente".
      </p>
    </div>
  </div>

  <script>
    (() => {
      const ONBOARD_KEY = "cp:onboarded";
      const modal = document.getElementById("onboarding-modal");
      const helpModal = document.getElementById("help-modal");
      const callout = document.getElementById("demo-callout");
      const demoBtn = document.getElementById("guided-demo-btn");
      const demoLabel = document.getElementById("guided-demo-label");

      const wait = (ms) => new Promise((r) => setTimeout(r, ms));

      // Element.click() no existe en nodos SVG (el <g> de cada nodo del canvas),
      // asi que disparamos el MouseEvent a mano para que sirva con botones y con SVG.
      function fireClick(el) {
        el?.dispatchEvent(new MouseEvent("click", { bubbles: true, cancelable: true, view: window }));
      }

      // El <select> de entrada de trafico y el <input type="range"> de RPS usan
      // phx-change, que LiveView escucha sobre el evento "change" nativo —
      // no alcanza con asignar .value.
      function fireChange(el, value) {
        if (!el) return;
        el.value = value;
        el.dispatchEvent(new Event("change", { bubbles: true, cancelable: true }));
      }

      function closeOnboarding() {
        modal.classList.add("hidden");
        localStorage.setItem(ONBOARD_KEY, "1");
      }

      if (!localStorage.getItem(ONBOARD_KEY)) {
        modal.classList.remove("hidden");
      }

      document.getElementById("onboarding-skip").addEventListener("click", closeOnboarding);
      document.getElementById("onboarding-start-demo").addEventListener("click", () => {
        closeOnboarding();
        runGuidedDemo();
      });

      const helpBtn = document.getElementById("help-open");
      if (helpBtn) helpBtn.addEventListener("click", () => helpModal.classList.remove("hidden"));
      document.getElementById("help-close").addEventListener("click", () => helpModal.classList.add("hidden"));
      helpModal.addEventListener("click", (e) => {
        if (e.target === helpModal) helpModal.classList.add("hidden");
      });

      const calloutStep = document.getElementById("demo-callout-step");
      const calloutText = document.getElementById("demo-callout-text");
      const skipBtn = document.getElementById("demo-skip");

      // callout es position:fixed -> las coordenadas son relativas al viewport,
      // no hace falta (ni corresponde) sumar window.scrollY. Ancho/alto se miden
      // ya visible (con el texto del paso puesto) porque w-[calc(100vw-24px)]
      // hace que el tamaño real dependa del viewport y del contenido.
      function positionCallout(target) {
        if (!target) return;
        const margin = 12;
        const rect = target.getBoundingClientRect();
        const calloutW = callout.offsetWidth;
        const calloutH = callout.offsetHeight;

        const left = Math.min(
          Math.max(margin, rect.left + rect.width / 2 - calloutW / 2),
          window.innerWidth - calloutW - margin,
        );

        let top = rect.bottom + 10;
        if (top + calloutH > window.innerHeight - margin) {
          top = rect.top - 10 - calloutH; // no entra abajo -> lo mostramos arriba
        }
        top = Math.max(margin, Math.min(top, window.innerHeight - calloutH - margin));

        callout.style.left = `${left}px`;
        callout.style.top = `${top}px`;
      }

      let calloutTarget = null;

      function showCallout(target, step, total, text) {
        calloutTarget = target;
        calloutStep.textContent = `Paso ${step}/${total}`;
        calloutText.textContent = text;
        callout.classList.remove("hidden");
        positionCallout(target);
      }

      function hideCallout() {
        callout.classList.add("hidden");
        calloutTarget = null;
      }

      window.addEventListener("resize", () => {
        if (calloutTarget) positionCallout(calloutTarget);
      });

      let demoRunning = false;
      let demoCancelled = false;

      // Cada paso explica ANTES de actuar (le da tiempo a leer), despues actua,
      // y deja el resultado a la vista un rato antes de pasar al siguiente paso.
      async function runStep({ target, step, total, text, before = 1400, action = null, after = 2600 }) {
        if (demoCancelled) return;
        showCallout(target, step, total, text);
        await wait(before);
        if (demoCancelled) return;
        if (action) action();
        await wait(after);
      }

      async function runGuidedDemo() {
        if (demoRunning) return;
        demoRunning = true;
        demoCancelled = false;
        demoBtn.disabled = true;
        demoLabel.textContent = "Corriendo demo…";
        skipBtn.classList.remove("hidden");

        const metricsTarget = document.getElementById("metrics-dl");
        const inspector = document.getElementById("inspector-panel");
        const total = 10;

        await runStep({
          target: metricsTarget,
          step: 1,
          total,
          text: "Esta es 'Monolith vs Microservices': dos arquitecturas equivalentes corriendo en paralelo. Vamos a romper cada una y comparar cómo aguantan.",
          before: 3200,
          after: 400,
        });

        await runStep({
          target: metricsTarget,
          step: 2,
          total,
          text: "Primero reiniciamos la topología en limpio: esto mata y vuelve a levantar todos los procesos de nodo.",
          before: 1200,
          action: () => fireClick(document.querySelector('button[phx-value-name="Monolith vs Microservices"]')),
          after: 2200,
        });

        await runStep({
          target: metricsTarget,
          step: 3,
          total,
          text: "Arrancamos tráfico simulado, entrando por el load balancer del monolito. Cada partícula es un paquete real recorriendo las conexiones.",
          before: 1400,
          action: () => {
            const startBtn = document.querySelector('button[phx-click="start_traffic"]');
            if (startBtn && !startBtn.disabled) startBtn.click();
          },
          after: 3400,
        });

        await runStep({
          target: metricsTarget,
          step: 4,
          total,
          text: "Vamos a elegir el nodo de API del monolito para intervenirlo. Un clic abre su Inspector, a la derecha.",
          before: 1400,
          action: () => fireClick(document.querySelector('[data-node-id="monolith-app"]')),
          after: 2000,
        });

        await runStep({
          target: inspector,
          step: 5,
          total,
          text: "Es un proceso real de Erlang/OTP. Cuando lo matemos, termina de verdad — y como es un Single Point of Failure, se lleva puesto todo lo que depende de él.",
          before: 2600,
          action: () => fireClick(document.querySelector('button[phx-click="kill_node"]')),
          after: 3400,
        });

        await runStep({
          target: metricsTarget,
          step: 6,
          total,
          text: "Proceso terminado. Mirá el ERROR%: sin ese único camino, todo el tráfico del monolito falla — no es una animación, es tráfico real sin adónde ir.",
          before: 0,
          after: 3200,
        });

        const entryForm = document.getElementById("entry-node-form");

        await runStep({
          target: entryForm,
          step: 7,
          total,
          text: "Probemos lo mismo en microservicios: cambiamos la entrada de tráfico a su load balancer, con 3 instancias de API corriendo en paralelo.",
          before: 1400,
          action: () => fireChange(document.getElementById("entry-node-select"), "micro-lb"),
          after: 3000,
        });

        await runStep({
          target: metricsTarget,
          step: 8,
          total,
          text: "Vamos a matar una de las tres réplicas de API, micro-svc-a — exactamente lo mismo que le hicimos al monolito.",
          before: 1400,
          action: () => fireClick(document.querySelector('[data-node-id="micro-svc-a"]')),
          after: 2000,
        });

        await runStep({
          target: inspector,
          step: 9,
          total,
          text: "Mismo proceso real, mismo botón. A diferencia del monolito, acá no hay un solo punto de falla.",
          before: 2600,
          action: () => fireClick(document.querySelector('button[phx-click="kill_node"]')),
          after: 3400,
        });

        await runStep({
          target: metricsTarget,
          step: 10,
          total,
          text: "Mirá el ERROR%: apenas se nota. Las otras dos instancias absorbieron el tráfico sin drama — esa es la diferencia entre un SPOF y una arquitectura redundante.",
          before: 0,
          after: 3600,
        });

        if (!demoCancelled) {
          // Deja todo como estaba antes de la demo: nodos revividos, trafico
          // pausado, RPS y entrada de trafico en su valor por defecto — para
          // que quien mire despues no se encuentre el canvas roto.
          fireClick(document.querySelector('[data-node-id="monolith-app"]'));
          await wait(300);
          fireClick(document.querySelector('button[phx-click="revive_node"]'));
          await wait(400);
          fireClick(document.querySelector('[data-node-id="micro-svc-a"]'));
          await wait(300);
          fireClick(document.querySelector('button[phx-click="revive_node"]'));
          await wait(400);

          const pauseBtn = document.querySelector('button[phx-click="pause_traffic"]');
          if (pauseBtn && !pauseBtn.disabled) pauseBtn.click();
          fireChange(document.getElementById("entry-node-select"), "monolith-lb");
          fireChange(document.getElementById("rps-input"), "5");
          fireClick(document.querySelector('button[phx-click="clear_selection"]'));

          showCallout(
            document.getElementById("guided-demo-btn"),
            total,
            total,
            "Repusimos los nodos y volvimos todo a como estaba. Ahora te toca a vos: seguí rompiendo cosas.",
          );
          await wait(3800);
        }

        hideCallout();
        skipBtn.classList.add("hidden");
        demoBtn.disabled = false;
        demoLabel.textContent = "Demo guiada (45s)";
        demoRunning = false;
      }

      skipBtn.addEventListener("click", () => {
        demoCancelled = true;
        hideCallout();
        skipBtn.classList.add("hidden");
        demoBtn.disabled = false;
        demoLabel.textContent = "Demo guiada (45s)";
        demoRunning = false;
      });

      demoBtn.addEventListener("click", runGuidedDemo);
    })();
  </script>
</div>
